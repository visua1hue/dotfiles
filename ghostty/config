# Build:
# https://ghostty.org/docs/install/pre#macos

auto-update-channel = tip


# General Adjustments:
# https://ghostty.org/docs/config/reference

shell-integration = zsh
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

copy-on-select = clipboard
confirm-close-surface = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = 4
window-colorspace = display-p3
window-save-state = always
window-padding-balance = true
window-padding-y = 10
window-padding-x = 10
adjust-cell-height = -2%
unfocused-split-opacity = 0.5
unfocused-split-fill = #000000
split-divider-color = #52525b

cursor-style = block
cursor-color = cell-foreground
adjust-cursor-thickness = 20
custom-shader = shaders/cursor_smear.glsl

theme = Cursor Dark
foreground = #a1a1aa

font-family = JetBrainsMono Nerd Font Mono
font-size = 18

macos-icon = xray
macos-window-shadow = false


# Keybindings:
# https://ghostty.org/docs/config/keybind#modifiers
# https://ghostty.org/docs/config/keybind/reference

# Reload config
keybind = command+r=reload_config

# Fetch for updates
keybind = command+shift+u=check_for_updates

# Delete from cursor to start of line (Default)
keybind = command+backspace=text:\x15

# Jump to start / end of line (Default)
keybind = command+left=text:\x01
keybind = command+right=text:\x05

# Jump one word backward / forward (Default)
keybind = alt+left=esc:b
keybind = alt+right=esc:f

# Clear the visible screen (and scrollback) (Default)
keybind = command+k=clear_screen

# Scroll to the previous / next shell prompt (requires shell-integration)
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1

# New tab (Default)
keybind = command+t=new_tab

# Close tab / pane (Default)
keybind = command+w=close_surface

# New split right / down (Default)
keybind = command+d=new_split:right
keybind = command+shift+d=new_split:down
